                        <td>{{user.name}}</td>\r
                        <td>{{user.email}}</td>\r
                        <td>{{user.role}}</td>\r
                        <td>{{user.status}}</td>\r
                        <td>\r
                            <button class="btn btn-sm btn-info" (click)="edit(user)">Edit</button>\r
                            <button class="btn btn-sm btn-danger ms-1" (click)="delete(user.id)">Delete</button>\r
                        </td>\r
                    </tr>\r
                </tbody>\r
\r
            </table>\r
        </div>\r
\r
    </div>\r
</div>`, styles: ["/* src/app/components/user-management/user-management.css */\n.main {\n  width: 83%;\n  margin-left: 220px;\n  background-color: #FFFFFF;\n  font-family:\n    Arial,\n    Helvetica,\n    sans-serif;\n}\n.heading {\n  color: #2A2A2A;\n  margin-bottom: 20px;\n  font-weight: 700;\n}\n.card {\n  border-radius: 10px;\n  padding: 20px;\n  border: none;\n  width: 99%;\n  margin-left: 0.5%;\n}\n.card h5 {\n  color: #2A2A2A;\n  margin-bottom: 15px;\n  font-weight: 600;\n}\n.form-control {\n  background: #FFFFFF !important;\n  border: 1px solid #C8A94F !important;\n  color: #2A2A2A !important;\n  padding: 10px;\n  border-radius: 6px;\n  transition: all .2s;\n}\n.form-control:focus {\n  border-color: #b9983e !important;\n  box-shadow: 0 0 5px rgba(200, 169, 79, 0.4);\n}\n.card-flex {\n  display: flex;\n  gap: 12px;\n  flex-wrap: wrap;\n}\n.btn-primary {\n  background: #C8A94F;\n  border: 1px solid #C8A94F;\n  padding: 10px 20px;\n  color: white;\n  border-radius: 6px;\n  font-weight: 600;\n  transition: .2s;\n}\n.btn-primary:hover {\n  background: white;\n  color: #C8A94F;\n}\n.btn-secondary {\n  background: white;\n  border: 1px solid #C8A94F;\n  padding: 10px 20px;\n  color: #C8A94F;\n  border-radius: 6px;\n  font-weight: 600;\n}\n.btn-secondary:hover {\n  background: #C8A94F;\n  color: white;\n}\ntable {\n  color: #2A2A2A;\n  width: 99%;\n  margin-left: 0.5%;\n}\n.table-light th {\n  background: #c5940cbd !important;\n  color: black !important;\n  border-radius: 2px;\n  font-weight: 600;\n}\n.table-bordered td,\n.table-bordered th {\n  border: 1px solid white !important;\n}\n.btn-info {\n  background: #C8A94F;\n  border: none;\n  color: white;\n}\n.btn-info:hover {\n  background: #b9983e;\n}\n.btn-danger {\n  background: #dc3545;\n  border: none;\n}\n.btn-danger:hover {\n  background: #bb2d3b;\n}\n.error {\n  background: none;\n  color: red;\n  font-weight: bold;\n  display: flex;\n  align-items: center;\n  width: 100%;\n}\n/*# sourceMappingURL=user-manag