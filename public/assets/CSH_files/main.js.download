    <div class="container-fluid p-4">\r
        <h3 class="mb-4 ms-4">Booking </h3>\r
\r
        <!-- form start -->\r
        <div class="card p-3 mb-3">\r
            <form [formGroup]="formGroup" (ngSubmit)="save()">\r
\r
                <div style="margin-bottom: 40px;">\r
                    <h5 style="font-weight: 100 !important;margin-top: 20px;color: black;display: inline;">{{ editBooking ? 'Edit Booking' : 'Add Booking' }}</h5>\r
                    <button class="btn btn-info" (click)="roomDetails()" style="width: 200px;margin-left: 2%;">View Rooms Details</button>\r
                    <div class="prices">\r
                        <h1>Per Day Per Room Price : 15000 </h1>\r
                        <h3>Room Qty : {{roomQty()}}</h3>\r
                        <h3>Days : {{roomDay()}}</h3>\r
                        <h3>Total Price : {{totalPrice()}} </h3>\r
                        <input type="button" value="Room Qty + " (click)="addQty()">\r
                        <input type="button" value="Day +" (click)="finalPrice()">\r
                    </div>\r
                </div>\r
\r
                <div class="">\r
                    <div class="row">\r
                        <div class="col-md-3">\r
                            <label>Name</label>\r
                            <input class="form-control mb-2" formControlName="name" placeholder="Enter Name">\r
                            <div class="error" *ngIf="formGroup.get('name')?.invalid && formGroup.get('name')?.touched">\r
                                Name is required!\r
                            </div>\r
                        </div>\r
\r
                        <div class="col-md-3">\r
                            <label>Email</label>\r
                            <input class="form-control mb-2" formControlName="email" placeholder="Enter Email">\r
                            <div class="error" *ngIf="formGroup.get('email')?.invalid && formGroup.get('email')?.touched">\r
                                Valid Email required!\r
                            </div>\r
                        </div>\r
\r
                        <div class="col-md-3">\r
                            <label>Phone</label>\r
                            <input class="form-control mb-2" formControlName="phone" placeholder="Enter Phone-No">\r
                            <div class="error" *ngIf="formGroup.get('phone')?.invalid && formGroup.get('phone')?.touched">\r
                                Phone number required!\r
                            </div>\r
                        </div>\r
\r
                        <div class="col-md-3">\r
                            <label>Room Category</label>\r
                            <select class="form-control mb-2" formControlName="roomCtg">\r
                             <option value="Standard">STANDARD</option>\r
                             <option>DELUXE</option>\r
                             <option>SUITE</option>\r
                            </select>\r
                        </div>\r
                    </div>\r
\r
                    <div class="row">\r
                        <div class="col-md-3">\r
                            <label>Room Quantity</label>\r
                            <input class="form-control mb-2" formControlName="roomQty">\r
                        </div>\r
\r
                        <div class="col-md-3">\r
                            <label>Check-In</label>\r
                            <input type="date" class="form-control mb-2" formControlName="checkIn">\r
                        </div>\r
\r
                        <div class="col-md-3">\r
                            <label>Check-Out</label>\r
                            <input type="date" class="form-control mb-2" formControlName="checkOut">\r
                        </div>\r
\r
                        <div class="col-md-3 form-btn">\r
                            <button class="btn btn-primary" type="submit">{{ editBooking ? 'Update' : 'Book' }}</button>\r
                            <button class="btn btn-secondary ms-2" type="button" (click)="reset()">Clear</button>\r
                        </div>\r
                    </div>\r
\r
                </div>\r
\r
            </form>\r
        </div>\r
\r
        <!-- table start -->\r
        <div class="recipt">\r
            <div class="table-responsive tbl" style="min-width: 90% !important;">\r
                <table class="table table-hover">\r
\r
                    <thead class="table-light" style="background-color: #C8A94F; color: white;">\r
                        <tr>\r
                            <th>ID</th>\r
                            <th>Name</th>\r
                            <th>Email</th>\r
                            <th>Phone</th>\r
                            <th>Category</th>\r
                            <th>Room Qty</th>\r
                            <th>Check-In</th>\r
                            <th>Check-Out</th>\r
                            <th>Price</th>\r
                            <th>Actions</th>\r
                        </tr>\r
                    </thead>\r
\r
                    <tbody>\r
                        <tr *ngFor="let booking of bookings">\r
                            <td>{{ booking.id }}</td>\r
                            <td>{{ booking.name }}</td>\r
                            <td>{{ booking.email }}</td>\r
                            <td>{{ booking.phone }}</td>\r
                            <td>{{ booking.roomCtg }}</td>\r
                            <td>{{ booking.roomQty }}</td>\r
                            <td>{{ booking.checkIn }}</td>\r
                            <td>{{ booking.checkOut }}</td>\r
                            <td>{{price()}}</td>\r
                            <td>\r
                                <button class="btn btn-sm btn-info" (click)="edit(booking)">Edit</button>\r
                                <button class="btn btn-sm btn-danger ms-1" (click)="delete(booking.id)">Delete</button>\r
                            </td>\r
                        </tr>\r
                    </tbody>\r
\r
                </table>\r
            </div>\r
        </div>\r
\r
    </div>\r
</div>`, styles: ["/* src/app/components/booking/booking.css */\n.main {\n  width: 83%;\n  margin-left: 220px;\n  background-color: #FFFFFF;\n  font-family:\n    Arial,\n    Helvetica,\n    sans-serif;\n}\n.heading {\n  color: #2A2A2A;\n  margin-bottom: 20px;\n  font-weight: 700;\n}\n.card {\n  border-radius: 10px;\n  padding: 20px;\n  border: none;\n  width: 99%;\n  margin-left: 0.5%;\n}\n.card h5 {\n  color: #2A2A2A;\n  margin-bottom: 15px;\n  font-weight: 600;\n}\n.form-control {\n  background: #FFFFFF !important;\n  border: 1px solid #C8A94F !important;\n  color: #2A2A2A !important;\n  padding: 10px;\n  border-radius: 6px;\n  transition: all .2s;\n}\n.form-control:focus {\n  border-color: #b9983e !important;\n  box-shadow: 0 0 5px rgba(200, 169, 79, 0.4);\n}\n.card-flex {\n  display: flex;\n  gap: 12px;\n  flex-wrap: wrap;\n}\n.form-btn {\n  margin-top: 22.5px;\n}\n.btn-primary {\n  background: #C8A94F;\n  border: 1px solid #C8A94F;\n  padding: 10px 20px;\n  color: white;\n  border-radius: 6px;\n  font-weight: 600;\n  transition: all 0.2s ease-in-out;\n}\n.btn-primary:hover {\n  background: white;\n  color: #C8A94F;\n}\n.btn-secondary {\n  background: white;\n  border: 1px solid #C8A94F;\n  padding: 10px 20px;\n  color: #C8A94F;\n  border-radius: 6px;\n  font-weight: 600;\n}\n.btn-secondary:hover {\n  background: #C8A94F;\n  color: white;\n}\ntable {\n  color: #2A2A2A;\n  width: 99%;\n  margin-left: 0.5%;\n}\n.table-light th {\n  background: #c5940cbd !important;\n  color: black !important;\n  font-weight: 600;\n}\n.table-bordered td,\n.table-bordered th {\n  border: 1px solid white !important;\n}\n.btn-info {\n  background: #C8A94F;\n  border: none;\n  color: white;\n}\n.btn-info:hover {\n  background: #b9983e;\n}\n.btn-danger {\n  background: #dc3545;\n  border: none;\n}\n.btn-danger:hover {\n  background: #bb2d3b;\n}\n.error {\n  background: none;\n  color: red;\n  font-weight: bold;\n  display: flex;\n  align-items: center;\n  width: 100%;\n}\n/*# sourceMapp