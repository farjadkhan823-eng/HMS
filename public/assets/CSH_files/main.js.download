(() => {
  (typeof ngDevMode === "undefined" || ngDevMode) && i07.\u0275setClassMetadata(RoomManagement, [{
    type: Component4,
    args: [{ selector: "app-room-management", standalone: true, imports: [FormsModule, CommonModule2], template: `<div class="main">\r
    <div class="container-fluid p-4">\r
        <h3 class="mb-4">Room Management</h3>\r
        <!-- form start -->\r
        <div class="card p-3 mb-3">\r
            <h5>{{ editRoom ? 'Edit Room' : 'Add Room' }}</h5>\r
            <div class="card-flex">\r
                <div class="row">\r
                    <div class="row">\r
                        <div class="col-md">\r
                            <label for="">Select Room</label>\r
                            <select class="form-control mb-2" [(ngModel)]="form.room">\r
                                <option value="Select">Select Role</option>\r
                                <option>Standard</option>\r
                                <option>Deluxe</option>\r
                                <option>Suite</option>\r
                            </select>\r
                        </div>\r
\r
                        <div class="col-md">\r
                            <label for="">Room Price</label>\r
                            <input type="number" class="form-control mb-2" id="price" name="price" [(ngModel)]="form.price">\r
                        </div>\r
\r
                        <div class="col-md">\r
                            <label for="">Bed</label>\r
                            <input type="text" class="form-control mb-2" id="bed" name="bed" [(ngModel)]="form.bed">\r
                        </div>\r
\r
                        <div class="col-md">\r
                            <label for="">Windows</label>\r
                            <input type="text" class="form-control mb-2" id="window" name="window" [(ngModel)]="form.window">\r
                        </div>\r
\r
                        <div class="col-md">\r
                            <label for="">Smoking</label>\r
                            <select class="form-control mb-2" [(ngModel)]="form.smoking">\r
                                <option value="No">No</option>\r
                                <option>Yes</option>\r
                            </select>\r
                        </div>\r
                    </div>\r
\r
\r
                    <div class="row">\r
                        <div class="col-md">\r
                            <label for="">Room Size</label>\r
                            <input type="text" class="form-control mb-2" id="size" name="size" [(ngModel)]="form.size">\r
                        </div>\r
\r
                        <div class="col-md">\r
                            <label for="">Internet</label>\r
                            <select class="form-control mb-2" [(ngModel)]="form.internet">\r
                                <option value="No">No</option>\r
                                <option>Yes</option>\r
                            </select>\r
                        </div>\r
\r
                        <div class="col-md">\r
                            <label for="">Drinks</label>\r
                            <select class="form-control mb-2" [(ngModel)]="form.drink">\r
                                <option value="No">No</option>\r
                                <option>Yes</option>\r
                            </select>\r
                        </div>\r
\r
                        <div class="col-md">\r
                            <label for="">Snacks</label>\r
                            <select class="form-control mb-2" [(ngModel)]="form.snack">\r
                                <option value="No">No</option>\r
                                <option>Yes</option>\r
                            </select>\r
                        </div>\r
\r
                        <div class="col-md">\r
                            <label for="">Skin Care</label>\r
                            <select class="form-control mb-2" [(ngModel)]="form.skincare">\r
                                <option value="No">No</option>\r
                                <option>Yes</option>\r
                            </select>\r
                        </div>\r
                    </div>\r
\r
\r
                    <div class="row">\r
                        <h5>Room Appliances</h5>\r
                        <div class="col-md">\r
                            <label for="">Air Conditioner</label>\r
                            <select class="form-control mb-2" [(ngModel)]="form.ac">\r
                                <option value="No">No</option>\r
                                <option>Yes</option>\r
                            </select>\r
                        </div>\r
\r
                        <div class="col-md">\r
                            <label for="">Fan</label>\r
                            <select class="form-control mb-2" [(ngModel)]="form.fan">\r
                                <option value="No">No</option>\r
                                <option>Yes</option>\r
                            </select>\r
                        </div>\r
\r
                        <div class="col-md">\r
                            <label for="">Fridge</label>\r
                            <select class="form-control mb-2" [(ngModel)]="form.fridge">\r
                                <option value="No">No</option>\r
                                <option>Yes</option>\r
                            </select>\r
                        </div>\r
\r
                        <div class="col-md">\r
                            <label for="">Mircrowave</label>\r
                            <select class="form-control mb-2" [(ngModel)]="form.microwave">\r
                                <option value="No">No</option>\r
                                <option>Yes</option>\r
                            </select>\r
                        </div>\r
\r
                        <div class="col-md">\r
                            <label for="">Iron</label>\r
                            <select class="form-control mb-2" [(ngModel)]="form.iron">\r
                                <option value="No">No</option>\r
                                <option>Yes</option>\r
                            </select>\r
                        </div>\r
\r
                        <div class="col-md">\r
                            <label for="">Media</label>\r
                            <select class="form-control mb-2" [(ngModel)]="form.media">\r
                                <option value="No">No</option>\r
                                <option>Yes</option>\r
                            </select>\r
                        </div>\r
\r
                    </div>\r
\r
\r
                    <div class="row">\r
                        <div class="col-md-1"><button class="btn btn-primary" (click)="save()"> {{ editRoom ? 'Update' :\r
                                'Add' }}</button></div>\r
                        <div class="col-md-1"><button class="btn btn-secondary ms-2" (click)="reset()">Clear</button>\r
                        </div>\r
                    </div>\r
                </div>\r
            </div>\r
        </div>\r
\r
\r
\r
        <!-- table start -->\r
        <div class="table-responsive" style="min-width: 90% !important;">\r
            <table class="table table-hover align-middle" style="border: 2px solid #C8A94F; border-radius: 12px; overflow: hidden;">\r
\r
                <thead class="table-light" style="background-color: #C8A94F; color: white;">\r
                    <tr>\r
                        <th>#</th>\r
                        <th>Room Ctg</th>\r
                        <th>Room Price</th>\r
                        <th>Bed</th>\r
                        <th>Windows</th>\r
                        <th>Smoking</th>\r
                        <th>Room Size</th>\r
                        <th>Internet</th>\r
                        <th>Drinks</th>\r
                        <th>Snacks</th>\r
                        <th>Skin-Care</th>\r
                        <th>Media</th>\r
                        <th>AC</th>\r
                        <th>Fans</th>\r
                        <th>Fridge</th>\r
                        <th>Microwave</th>\r
                        <th>Iron</th>\r
                        <th>Action</th>\r
                        <th>Details</th>\r
                    </tr>\r
                </thead>\r
\r
                <tbody>\r
                    <tr *ngFor="let room of rooms()">\r
                        <td>{{room.id}}</td>\r
                        <td>{{room.room}}</td>\r
                        <td>{{room.price}}</td>\r
                        <td>{{room.bed}}</td>\r
                        <td>{{room.window}}</td>\r
                        <td>{{room.smoking}}</td>\r
                        <td>{{room.size}}</td>\r
                        <td>{{room.internet}}</td>\r
                        <td>{{room.drink}}</td>\r
                        <td>{{room.snack}}</td>\r
                        <td>{{room.skincare}}</td>\r
                        <td>{{room.media}}</td>\r
                        <td>{{room.ac}}</td>\r
                        <td>{{room.fan}}</td>\r
                        <td>{{room.fridge}}</td>\r
                        <td>{{room.microwave}}</td>\r
                        <td>{{room.iron}}</td>\r
                        <td>\r
                            <button class="btn btn-sm btn-info" (click)="edit(room)">Edit</button>\r
                            <button class="btn btn-sm btn-danger ms-1" (click)="delete(room.id)">Delete</button>\r
                        </td>\r
                        <td>\r
                            <button type="button" class="btn" id="dtl" data-bs-toggle="modal" data-bs-target="#exampleModal" style="background-color: aqua;color: white;" (click)="setRoomCatIdInRoomDetail(room.id)">View</button>\r
                        </td>\r
                    </tr>\r
                </tbody>\r
\r
            </table>\r
        </div>\r
\r
    </div>\r
</div>\r
\r
<div class="other-tbl">\r
    <div class="dlt-grid">\r
        <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">\r
            <div class="modal-dialog">\r
                <div class="modal-content" style="width: 1115px !important;margin-left: -200px !important;">\r
                    <div>\r
                        <h3 class="mb-4 rl">Rooms Listing</h3>\r
                    </div>\r
                    <div class="modal-body">\r
                        <!-- form start -->\r
                        <div class="card p-3 mb-3">\r
                            <h5>{{ editRoomDetail ? 'Edit Room Details' : 'Add Room Details' }}\r
                            </h5>\r
                            <div class="card-flex listing-flex">\r
                                <input type="text" class="form-control mb-2" id="roomNo" name="roomNo" [(ngModel)]="details.roomNo" placeholder="Enter Room Number">\r
                                <select class="form-control mb-2" [(ngModel)]="details.status">\r
                                                                <option value="Active">Active</option>\r
                                                                <option value="Inactive">Inactive</option>\r
                                                            </select>\r
\r
                                <select class="form-control mb-2" [(ngModel)]="details.reason">\r
                                                                <option>Free</option>\r
                                                                <option>Booked</option>\r
                                                                <option>Cleaning</option>\r
                                                                <option>Maintenance</option>\r
                                                            </select>\r
                                <div class="dtl">\r
                                    <button class="btn btn-primary" (click)s="saveDetails(roomDetailId());">\r
                                                                    {{ editRoomDetail ? 'Update' : 'Add' }}\r
                                                                </button>\r
                                    <button class="btn btn-secondary ms-2" (click)="resetDetail()">Clear</button>\r
                                </div>\r
                            </div>\r
                        </div>\r
\r
                        <!-- table start -->\r
                        <div class="" style="width: 66% !important;">\r
                            <table class="table table-hover align-middle" style="border: 2px solid #C8A94F; border-radius: 12px; overflow: hidden;">\r
\r
                                <thead class="table-light" style="background-color: #C8A94F; color: white;">\r
                                    <tr>\r
                                        <th>#</th>\r
                                        <th>Room Number</th>\r
                                        <th>Status</th>\r
                                        <th>Reason</th>\r
                                        <th>Action</th>\r
                                    </tr>\r
                                </thead>\r
\r
                                <tbody>\r
                                    <!-- {{room.rooms | json}} -->\r
                                    <tr *ngFor="let roomDetails of roomsDetails">\r
                                        <td>{{roomDetails.id}}</td>\r
                                        <td>{{roomDetails.roomNo}}</td>\r
                                        <td>{{roomDetails.status}}</td>\r
                                        <td>{{roomDetails.reason}}</td>\r
                                        <td>\r
                                            <button class="btn btn-info " (click)="editDetails(roomDetails) ">Edit</button>\r
                                            <button class="btn btn-danger ms-1 " (click)="deleteDetail(roomDetails.id) ">Delete</button>\r
                                        </td>\r
                                    </tr>\r
                                </tbody>\r
\r
                            </table>\r
                        </div>\r
                    </div>\r
                    <div>\r
                        <button type="button " class="btn btn-secondary close " data-bs-dismiss="modal ">Close</button>\r
                    </div>\r
                </div>\r
            </div>\r
        </div>\r
    </div>\r
</div>\r
\r
\r
\r
\r
\r
