    args: [{ selector: "app-privacy-policy", imports: [], template: '<div class="main">\r\n    <br>\r\n    <section class="policy-hero">\r\n        <h2>Privacy Policy</h2>\r\n        <p>\r\n            We value your trust and are committed to protecting your personal information.\r\n        </p>\r\n    </section>\r\n\r\n    <section class="policy-content py-5">\r\n        <div class="container">\r\n            <div class="row">\r\n                <div class="col-lg-10 mx-auto policy-card">\r\n\r\n                    <p class="updated-date">\r\n                        <strong>Last Updated:</strong> January 1, 2025\r\n                    </p>\r\n\r\n                    <div class="policy-section">\r\n                        <h3>1. Introduction</h3>\r\n                        <p>\r\n                            This Privacy Policy explains how our hotel collects, uses, stores, and protects your personal information when you use our website, make reservations, or interact with our services.\r\n                        </p>\r\n                    </div>\r\n\r\n                    <div class="policy-section">\r\n                        <h3>2. Information We Collect</h3>\r\n                        <p>We may collect the following types of information:</p>\r\n                        <ul>\r\n                            <li>Personal identification and contact details</li>\r\n                            <li>Reservation and stay-related information</li>\r\n                            <li>Payment and billing information</li>\r\n                            <li>Technical data such as IP address and browser type</li>\r\n                        </ul>\r\n                    </div>\r\n\r\n                    <div class="policy-section">\r\n                        <h3>3. How We Use Your Information</h3>\r\n                        <ul>\r\n                            <li>To manage bookings and provide hotel services</li>\r\n                            <li>To process payments securely</li>\r\n                            <li>To improve our website and guest experience</li>\r\n                            <li>To communicate service updates and confirmations</li>\r\n                        </ul>\r\n                    </div>\r\n\r\n                    <div class="policy-section">\r\n                        <h3>4. Cookies and Tracking Technologies</h3>\r\n                        <p>\r\n                            Cookies help us enhance functionality and analyze website traffic. You may control cookie settings through your browser preferences.\r\n                        </p>\r\n                    </div>\r\n\r\n                    <div class="policy-section">\r\n                        <h3>5. Data Security</h3>\r\n                        <p>\r\n                            We apply industry-standard security measures to protect your data. However, no system can be guaranteed to be completely secure.\r\n                        </p>\r\n                    </div>\r\n\r\n                    <div class="policy-section">\r\n                        <h3>6. Your Rights</h3>\r\n                        <ul>\r\n                            <li>Request access to your personal data</li>\r\n                            <li>Request correction or deletion</li>\r\n                            <li>Withdraw consent where applicable</li>\r\n                        </ul>\r\n                    </div>\r\n\r\n                    <div class="policy-section">\r\n                        <h3>7. Contact Information</h3>\r\n                        <p>\r\n                            If you have questions regarding this Privacy Policy, please contact us at:\r\n                        </p>\r\n                        <p>\r\n                            <strong>Email:</strong> cstarhotel@gmail.com<br />\r\n                            <strong>Phone:</strong> +92 123-456-789-0\r\n                        </p>\r\n                    </div>\r\n\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </section>\r\n\r\n</div>', styles: ["/* src/app/components/privacy-policy/privacy-policy.css */\n.main {\n  width: 83%;\n  margin-left: 220px;\n}\n.policy-hero {\n  background:\n    linear-gradient(\n      135deg,\n      #dfb741,\n      #5a4814);\n  color: white;\n  width: 90%;\n  height: 200px;\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  align-items: center;\n  margin: auto;\n  border-radius: 10px;\n}\n.policy-hero h2 {\n  font-size: 2.2rem;\n  font-weight: 600;\n}\n.policy-hero p {\n  max-width: 750px;\n  margin: 15px auto 0;\n  font-size: 1.1rem;\n}\n.policy-card {\n  border-radius: 10px;\n  padding: 40px;\n  transition: transform 0.3s ease, box-shadow 0.3s ease;\n}\n.policy-section {\n  padding: 20px;\n  border-left: 4px solid transparent;\n  border-radius: 6px;\n  margin-bottom: 15px;\n  transition: all 0.3s ease-in-out;\n}\n.policy-section:hover {\n  border-left-color: #a2842d;\n  box-shadow: 0px 0px 10px rgb(133, 133, 133);\n}\n.policy-content h3 {\n  font-weight: 600;\n  margin-bottom: 12px;\n  transition: color 0.3s ease;\n}\n.policy-section:hover h3 {\n  color: #a2842d;\n}\n.policy-content p,\n.policy-content li {\n  color: rgb(53, 53, 53);\n  line-height: 1.8;\n}\n.policy-section:hover p {\n  color: black;\n}\n.policy-section:hover li {\n  color: black;\n}\n.policy-content ul {\n  padding-left: 20px;\n}\n.updated-date {\n  color: #777;\n  font-size: 0.95rem;\n  margin-bottom: 30px;\n}\n.policy-content a {\n  color: #0d6efd;\n  text-decoration: none;\n  transition: color 0.2s ease, text-decoration 0.2s ease;\n}\n.policy-content a:hover {\n  color: #084298;\n  text-decoration: underline;\n}\n/*# sourceMappingURL=privacy-policy.css.map */\n"] }]
