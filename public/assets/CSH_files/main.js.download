    <div class="container-fluid p-4">\r
        <h3 class="mb-4">User Management</h3>\r
        <!-- form start -->\r
        <div class="card p-3 mb-3">\r
            <form [formGroup]="formGroup" (ngSubmit)="onSubmit()">\r
                <h5>{{ editUser ? 'Edit User' : 'Add User' }}</h5>\r
\r
                <div class="card-flex">\r
                    <label>Enter User Name</label>\r
                    <div *ngIf="formGroup.get('name')?.invalid && formGroup.get('name')?.touched" class="error">\r
                        Name is required !\r
                    </div>\r
                    <input class="form-control mb-2" placeholder="Name" formControlName="name">\r
                    <label>Enter User Email</label>\r
                    <div *ngIf="formGroup.get('email')?.invalid && formGroup.get('email')?.touched" class="error">\r
                        Email is required !\r
                    </div>\r
                    <input class="form-control mb-2" placeholder="Email" formControlName="email" required>\r
                    <label>Enter User Password</label>\r
                    <div *ngIf="formGroup.get('password')?.invalid && formGroup.get('password')?.touched" class="error">\r
                        Minimum 8 Character !\r
                    </div>\r
                    <input class="form-control mb-2" placeholder="Password" formControlName="password">\r
                    <label>Select User Role</label>\r
                    <select class="form-control mb-2" formControlName="role">\r
            <option value="">Select Role</option>\r
            <option>Admin</option>\r
            <option>Manager</option>\r
            <option>Accountant</option>\r
            <option>Receptionist</option>\r
        </select>\r
\r
                    <label>Select User Status</label>\r
                    <select class="form-control mb-2" formControlName="status">\r
            <option value="active">Active</option>\r
            <option value="inactive">Inactive</option>\r
        </select>\r
\r
                    <button type="submit" class="btn btn-primary" (click)="save()" [disabled]="!formGroup.valid">\r
            {{ editUser ? 'Update' : 'Add' }}\r
        </button>\r
\r
                    <button class="btn btn-secondary ms-2" (click)="reset()">Clear</button>\r
                </div>\r
            </form>\r
        </div>\r
\r
\r
        <!-- table start -->\r
        <div class="table-responsive" style="min-width: 90% !important;">\r
            <table class="table table-hover align-middle" style="border: 2px solid #C8A94F; border-radius: 12px; overflow: hidden;">\r
\r
                <thead class="table-light" style="background-color: #C8A94F; color: white;">\r
                    <tr>\r
                        <th>ID</th>\r
                        <th>Name</th>\r
                        <th>Email</th>\r
                        <th>Role</th>\r
                        <th>Status</th>\r
                        <th>Actions</th>\r
